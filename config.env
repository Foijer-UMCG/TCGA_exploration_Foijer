# Directory where the data will live - if data is already present,
# does not redownload it (unless FORCE=TRUE)
# this should be an absolute, not a relative path
DATA_DIR=D:/TCGA_data

# name of the run - use the format yyy_mm_dd_initials - NO SPACES!
# this determines where your plots are saved when finished.
RUN_NAME=2025_09_19_AvK

# Name of the dataset you want to get plots from
DATASET_NAME=TCGA-LUAD
# Whether you want to download the data - will throw an error if the data
# is not present in your assigned DATA_DIR (TRUE or FALSE)
DOWNLOAD_DATA=TRUE

# What data modalities do you want?
# Determines what plots will be made after processing the data
# These are always assumed to be TRUE, script WILL BREAK when FALSE
CLINICAL=TRUE
CNV=TRUE
TRANSCRIPTOME=TRUE
# Protein data from TCGA is a bit sparse since a lot of the data is old.
# Cannot guarantee this works as expected!
PROTEIN=FALSE

# ATAC_seq data has some unique considerations for downloading
# and processing, so currently not supported
#ATAC_SEQ=FALSE

# Genes of interest - 1 needs to be filled in, 2nd is optional
# Expected as a gene symbol (like BRCA1, TP53) or empty
# correct spelling is essential here - warnings will be given if incorrect
GENE_1=EP300
GENE_2=STAT1

# What kind of samples do you want in downstream analysis?
# Choice between "PRIMARY", "METASTATIC", "ALL" (without the quotation marks)
SAMPLES_SELECTED=PRIMARY

# Do you want to run GSEA between healthy and disease samples?
# one of TRUE or FALSE, not all datasets have matched healthy samples
GSEA=FALSE

# Do you want to redownload the data, even if it is already present?
# One of TRUE or FALSE
FORCE=TRUE

# Do you want verbose output into the terminal for progress?
# This includes some warnings/error reporting
VERBOSE=TRUE
